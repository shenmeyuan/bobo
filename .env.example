# Bobo's brain. Keys stay in the Electron main process.
OPENAI_API_KEY=
OPENAI_MODEL=your-model-id
OPENAI_BASE_URL=https://api.openai.com/v1
# responses (official API) or chat (a compatible gateway)
OPENAI_API_MODE=responses
OPENAI_REASONING_EFFORT=medium

# Model Hub alternative: when OPENAI_API_KEY is blank, use your AK and explicit endpoint.
# MODEL_HUB_AK=
# MODEL_HUB_BASE_URL=https://your-hub-host/v1
# MODEL_HUB_MODEL=your-deployment-name
# MODEL_HUB_API_MODE=chat
# For the Azure-compatible Model Hub endpoint supplied by your organization:
# MODEL_HUB_PROTOCOL=azure
# MODEL_HUB_API_VERSION=2024-02-01
# MODEL_HUB_BASE_URL=https://your-azure-endpoint.example/api/modelhub
# Optional; omit when the gateway does not support reasoning_effort.
# MODEL_HUB_REASONING_EFFORT=medium
# Per-model-request output cap; not an end-to-end task token budget.
BOBO_MAX_OUTPUT_TOKENS=2048

# Optional absolute CLI paths. Blank = detect from PATH and common locations.
BOBO_CODEX_PATH=
BOBO_CLAUDE_PATH=
# Supports the local traecli / Coco print CLI. Not TraeCode CLI 2.
BOBO_TRAE_PATH=
# Optional Claude model. Blank = the CLI's configured model.
BOBO_CLAUDE_MODEL=
# Select a workspace in Bobo's settings before starting local agent tasks.
BOBO_WORKSPACE=
# No write permission by default. Enable in the UI for the selected workspace.
# Portable config: set BOBO_ENV_PATH to an absolute path when using a packaged app.
