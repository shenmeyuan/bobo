{
  "name": "bobo-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "description": "Bobo — a growing desktop companion and a little agent keeper",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/start.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node scripts/smoke.mjs",
    "test:workflow": "node scripts/workflow-smoke.mjs",
    "test:supervisor": "node scripts/supervisor-smoke.mjs",
    "test:memory": "node scripts/memory-smoke.mjs",
    "test:work-memory": "node scripts/work-memory-smoke.mjs",
    "capture:product": "node scripts/capture-product.mjs",
    "check:publish": "node scripts/check-publish.mjs",
    "eval:handoff": "node scripts/eval-handoff.mjs",
    "eval:memory": "node scripts/eval-memory.mjs",
    "package": "npm run build && electron-builder --dir",
    "format": "prettier --write src electron scripts tests README.md *.json *.mjs",
    "eval:work-memory": "node scripts/eval-work-memory.mjs",
    "eval:project-memory": "node scripts/eval-project-memory.mjs",
    "test:permissions": "node scripts/permission-smoke.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "js-tiktoken": "1.0.21",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "openai": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "build": {
    "appId": "studio.sebas.bobo",
    "productName": "Bobo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dir"
      ],
      "identity": null,
      "icon": "electron/assets/icon.png"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "electronDist": "node_modules/electron/dist"
  }
}
